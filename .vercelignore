# The Vercel build only needs vercel-news/ (the app) and docs/ (the daily shell
# that build.js copies into public/). Everything else here is the Python scanner
# and its data — excluding it keeps the upload small and stops Vercel from
# trying to detect a Python project at the root.
#
# Note the directory entries below: these follow gitignore semantics, where a
# file cannot be re-included if its parent directory is itself excluded. The
# bare `!vercel-news` / `!docs` lines are what make the `!.../**` lines work.
*
!vercel-news
!vercel-news/**
!docs
!docs/index.html
!docs/alerts.json
# The build stamp open tabs poll to notice they are showing yesterday's paper.
# It is allow-listed by name like the two above — omit it and build.js finds
# nothing to copy, /edition.json 404s, and every tab silently stops checking.
!docs/edition.json
# The machine-readable edition the Telegram bot reads for /ideas and /desk.
# Allow-listed BY NAME like every other file here — omit it and the bot's
# section commands silently 404 with no error anywhere.
!docs/today.json
# The Nifty 500 research screen #stocks fetches lazily. Same by-name rule: omit
# it and the section falls back to its server-rendered top 25 forever, with the
# only symptom a console warning nobody reads.
!docs/screen.json
# The page script. Without this the site renders and does nothing.
!docs/app.js
!docs/robots.txt
!docs/sitemap.xml
!docs/manifest.webmanifest
!docs/icon.svg
!docs/og.png
!docs/desk.html
!docs/fonts
!docs/fonts/**

node_modules
smoke_runner.cjs

# Never ship the ledger or its WAL, even by accident.
signals.db
signals.db-shm
signals.db-wal
.env
